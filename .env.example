# Public project settings only. Copy to .env.local; never commit credentials.
VITE_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_TEST_PROJECT_PUBLISHABLE_KEY

# Watcher only. Use a dedicated cashier member, never a service-role key.
SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_TEST_PROJECT_PUBLISHABLE_KEY
CASHIER_EMAIL=
CASHIER_PASSWORD=
CASHIER_WATCH_FOLDER=
# Prefer a YYYY-MM-DD date in each export filename. Otherwise set explicitly:
CASHIER_SALE_DATE=

# Optional browser monitoring. Public Sentry DSN only. Keep empty until a project is connected.
VITE_SENTRY_DSN=
